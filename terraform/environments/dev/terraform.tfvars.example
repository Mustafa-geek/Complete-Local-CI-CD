aws_region        = "us-east-1"
project_name      = "three-tier"
github_repository = "OWNER/Three-Tier-Project"

vpc_cidr          = "10.0.0.0/16"
db_name           = "mydb"
db_username       = "appuser"
db_instance_class = "db.t4g.micro"

# First apply: false. After CI has pushed an initial image tag to both ECR
# repositories, set this to true and set initial_image_tag to that tag.
create_ecs_services = false
initial_image_tag   = "REPLACE-WITH-EXISTING-ECR-TAG"

frontend_desired_count = 1
backend_desired_count  = 1

# Optional HTTPS. Leave false until a Route53 hosted zone/domain is available.
enable_https  = false
domain_name   = null
hosted_zone_id = null

# If your AWS account already contains the GitHub Actions OIDC provider, set
# create_github_oidc_provider=false and supply its ARN below.
create_github_oidc_provider       = true
existing_github_oidc_provider_arn = null
