aws_region   = "us-east-1"
project_name = "three-tier"

# Existing networking. These resources are referenced, not created.
vpc_id = "vpc-0123456789abcdef0"

# ALB requires subnets in at least two Availability Zones.
alb_subnet_ids = [
  "subnet-aaaaaaaaaaaaaaaaa",
  "subnet-bbbbbbbbbbbbbbbbb"
]

# For the simplest demo you can use existing public subnets and leave
# assign_public_ip=true. In a production-style network, use private subnets
# with NAT/VPC endpoints and set assign_public_ip=false.
ecs_subnet_ids = [
  "subnet-aaaaaaaaaaaaaaaaa",
  "subnet-bbbbbbbbbbbbbbbbb"
]
assign_public_ip = true

# These ECR repositories must already exist and contain image_tag.
frontend_ecr_repository_name = "three-tier-frontend"
backend_ecr_repository_name  = "three-tier-backend"
image_tag                    = "latest"

# This IAM role must already exist. It needs the standard ECS task execution
# permissions plus secretsmanager:GetSecretValue for database_secret_name.
ecs_execution_role_name = "ecsTaskExecutionRole"

# Existing database / RDS information.
database_host = "replace-with-rds-endpoint.amazonaws.com"
database_port = 3306
database_name = "mydb"

# Existing Secrets Manager secret containing:
# {"username":"appuser","password":"..."}
database_secret_name = "three-tier/database/credentials"

# Optional: existing RDS/database security group. If provided, Terraform adds
# an ingress rule allowing MySQL from the backend ECS security group.
database_security_group_id = "sg-0123456789abcdef0"

frontend_desired_count = 1
backend_desired_count  = 1
